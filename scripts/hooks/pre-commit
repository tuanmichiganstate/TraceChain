#!/usr/bin/env sh
# Refuses a commit whose quality gate is red.
#
# Installed via `git config core.hooksPath scripts/hooks`, so it is versioned
# rather than living unversioned in .git/hooks. A commit was once made after a
# failing gate because the command was chained onto an echo instead of gated on
# the exit code; a remembered command is not a control, so this is one.
#
# SKIP_QUALITY_GATE=1 git commit ...   escape hatch, for docs-only work.
if [ -n "$SKIP_QUALITY_GATE" ]; then
  echo "pre-commit: quality gate skipped (SKIP_QUALITY_GATE set)"
  exit 0
fi
echo "pre-commit: running npm run quality ..."
if ! npm run quality --silent > /tmp/simuledger-precommit.log 2>&1; then
  echo "pre-commit: QUALITY GATE FAILED — commit refused."
  tail -20 /tmp/simuledger-precommit.log
  exit 1
fi
echo "pre-commit: quality gate green."
