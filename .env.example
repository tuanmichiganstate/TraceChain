# Optional comma-separated Sites-authenticated emails allowed to initialize
# the first administrator in an empty hosted D1 database.
TRACECHAIN_BOOTSTRAP_ADMIN_EMAILS=

# Optional LTI 1.3 Core, Scenario Author launch, Deep Linking, AGS, and NRPS
# registration. Scenario Author access requires a server-allowlisted
