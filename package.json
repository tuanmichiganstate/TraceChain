{
  "name": "tracechain",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "TraceChain - a simulated permissioned blockchain for supply-chain traceability education",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "npm run build && npm run build:scorm && npm run verify:scorm && node scripts/build-site.mjs",
    "build:site:from-artifacts": "node scripts/build-site.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:site": "node --test sites/worker.test.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:locales": "node scripts/validate-locales.mjs",
    "validate:scenario-schema": "node scripts/validate-scenario.mjs",
    "validate:scenario-contract": "node scripts/validate-scenario-contract.mjs",
    "validate:scenario": "npm run validate:scenario-schema && npm run validate:scenario-contract",
    "validate:platform-pack": "node scripts/validate-platform-pack.mjs",
    "validate:curriculum-overlays": "node scripts/validate-curriculum-overlays.mjs",
    "generate:content-review": "node scripts/generate-content-review.mjs",
    "generate:evidence-audit": "node scripts/learner-evidence-audit.mjs --write",
    "test:content-review": "node --test scripts/generate-content-review.test.mjs",
    "test:evidence-audit": "node --test scripts/learner-evidence-audit.test.mjs",
    "test:package-generator": "node --test scripts/scorm-package-policy.test.mjs",
    "package:scorm": "node scripts/build-scorm.mjs",
    "build:scorm": "node scripts/build-scorm.mjs --preset guided,practice,challenge,assessment,audit-guided,audit-practice,audit-challenge,audit-assessment --no-build --allow-dirty",
    "verify:scorm": "node scripts/verify-scorm.mjs",
    "verify:signature-evidence": "node scripts/verify-signature-evidence.mjs",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run test:site && npm run validate:locales && npm run validate:scenario && npm run validate:platform-pack && npm run validate:curriculum-overlays && npm run verify:e2e-matrix && npm run test:content-review && npm run test:evidence-audit && npm run test:package-generator && npm run verify:content-review && npm run verify:evidence-audit && npm run build && npm run build:scorm && npm run verify:scorm && npm run build:site:from-artifacts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "verify:content-review": "node scripts/verify-content-review.mjs",
    "verify:evidence-audit": "node scripts/learner-evidence-audit.mjs",
    "setup:hooks": "git config core.hooksPath scripts/hooks",
    "verify:e2e-matrix": "node scripts/verify-e2e-shards.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "3.1.0",
    "fflate": "^0.8.2",
    "jose": "^6.2.4",
    "js-yaml": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
