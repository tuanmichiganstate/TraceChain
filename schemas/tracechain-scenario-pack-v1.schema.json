{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracechain.example/schemas/tracechain-scenario-pack-v1.schema.json",
  "title": "TraceChain Scenario Pack V1",
  "description": "Portable, declarative scenario-pack envelope for TraceChain hosted and SCORM delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "status",
    "supportedLocales",
    "manifest",
    "competencyFrameworks",
    "rubrics",
    "evidenceRules",
    "scenarios",
    "assetHashes"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0.0" },
    "packId": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/version" },
    "status": { "$ref": "#/$defs/lifecycleStatus" },
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      }
    },
    "localizationCatalogs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manifest": { "$ref": "#/$defs/manifest" },
    "competencyFrameworks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/competencyFramework" }
    },
    "rubrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/rubric" }
    },
    "evidenceRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRule" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "assetHashes": {
      "type": "object",
      "propertyNames": {
        "not": { "pattern": "(?:^/|(?:^|/)\\.\\.(?:/|$))" }
      },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "publication": { "$ref": "#/$defs/publication" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["published", "retired"] }
        },
        "required": ["status"]
      },
      "then": { "required": ["publication"] },
      "else": {
        "not": { "required": ["publication"] }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lifecycleStatus": {
      "enum": ["draft", "validated", "published", "retired"]
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localizationKey"],
      "properties": {
        "localizationKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "domain", "educationalPurpose"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "domain": { "$ref": "#/$defs/identifier" },
        "educationalPurpose": { "$ref": "#/$defs/localizedText" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentHash", "publishedAt", "publishedBy"],
      "properties": {
        "contentHash": { "$ref": "#/$defs/sha256" },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "publishedBy": { "$ref": "#/$defs/identifier" }
      }
    },
    "performanceIndicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicatorId", "version", "statement"],
      "properties": {
        "indicatorId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "statement": { "$ref": "#/$defs/localizedText" }
      }
    },
    "competency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competencyId",
        "version",
        "title",
        "description",
        "indicators"
      ],
      "properties": {
        "competencyId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/performanceIndicator" }
        }
      }
    },
    "competencyFramework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "frameworkId",
        "version",
        "status",
        "title",
        "competencies"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "frameworkId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "title": { "$ref": "#/$defs/localizedText" },
        "competencies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/competency" }
        }
      }
    },
    "rubricLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "label": { "$ref": "#/$defs/localizedText" }
      }
    },
    "rubricCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "title",
        "description",
        "indicatorIds",
        "evidenceRuleIds"
      ],
      "properties": {
        "criterionId": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "indicatorIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "evidenceRuleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubricId", "version", "title", "levels", "criteria"],
      "properties": {
        "rubricId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "title": { "$ref": "#/$defs/localizedText" },
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/rubricLevel" }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rubricCriterion" }
        }
      }
    },
    "evidenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRuleId",
        "version",
        "indicatorIds",
        "operator",
        "eventType"
      ],
      "properties": {
        "evidenceRuleId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "indicatorIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "operator": {
          "enum": ["EVENT_OCCURRED", "FIELD_EQUALS", "FIELD_IN"]
        },
        "eventType": { "$ref": "#/$defs/identifier" },
        "fieldPath": { "type": "string", "minLength": 1 },
        "expectedValue": {
          "type": ["string", "number", "boolean"]
        },
        "expectedValues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["string", "number", "boolean"] }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operator": { "const": "FIELD_EQUALS" } },
            "required": ["operator"]
          },
          "then": { "required": ["fieldPath", "expectedValue"] }
        },
        {
          "if": {
            "properties": { "operator": { "const": "FIELD_IN" } },
            "required": ["operator"]
          },
          "then": { "required": ["fieldPath", "expectedValues"] }
        }
      ]
    },
    "competencyTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competencyId", "indicatorIds", "targetType"],
      "properties": {
        "competencyId": { "$ref": "#/$defs/identifier" },
        "indicatorIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "targetType": {
          "enum": ["primary", "supporting", "contextual"]
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "displayName"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/identifier" },
        "displayName": { "$ref": "#/$defs/localizedText" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleId", "organizationId", "displayName"],
      "properties": {
        "roleId": { "$ref": "#/$defs/identifier" },
        "organizationId": { "$ref": "#/$defs/identifier" },
        "displayName": { "$ref": "#/$defs/localizedText" }
      }
    },
    "assetType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetTypeId", "displayName", "schema"],
      "properties": {
        "assetTypeId": { "$ref": "#/$defs/identifier" },
        "displayName": { "$ref": "#/$defs/localizedText" },
        "schema": { "type": "object" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyType", "title", "configuration"],
      "properties": {
        "policyId": { "$ref": "#/$defs/identifier" },
        "policyType": {
          "enum": ["AUTHORIZATION", "BUSINESS_RULE", "LEGACY_POLICY"]
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "configuration": { "type": "object" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceType",
        "title",
        "sourceOrganizationId",
        "visibleToRoleIds",
        "content"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "evidenceType": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/localizedText" },
        "sourceOrganizationId": { "$ref": "#/$defs/identifier" },
        "visibleToRoleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "content": { "type": "object" }
      }
    },
    "transitionCondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "ALWAYS" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "decisionId", "optionId"],
          "properties": {
            "kind": { "const": "DECISION_OPTION_SELECTED" },
            "decisionId": { "$ref": "#/$defs/identifier" },
            "optionId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "policyId", "outcome"],
          "properties": {
            "kind": { "const": "POLICY_RESULT" },
            "policyId": { "$ref": "#/$defs/identifier" },
            "outcome": { "enum": ["pass", "fail"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "eventType"],
          "properties": {
            "kind": { "const": "EVENT_OCCURRED" },
            "eventType": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitionId", "toNodeId", "when"],
      "properties": {
        "transitionId": { "$ref": "#/$defs/identifier" },
        "toNodeId": { "$ref": "#/$defs/identifier" },
        "when": { "$ref": "#/$defs/transitionCondition" }
      }
    },
    "decisionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "label", "authoredValue"],
      "properties": {
        "optionId": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/localizedText" },
        "authoredValue": true
      }
    },
    "decisionField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "prompt", "selection", "options"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/identifier" },
        "prompt": { "$ref": "#/$defs/localizedText" },
        "selection": { "enum": ["single", "multiple"] },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/decisionOption" }
        }
      }
    },
    "stochasticOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomeId", "weight", "resultCode"],
      "properties": {
        "outcomeId": { "$ref": "#/$defs/identifier" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "resultCode": { "$ref": "#/$defs/identifier" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "nodeType", "title", "transitions"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "nodeType": {
          "enum": [
            "BRIEFING",
            "EVIDENCE_RELEASE",
            "DECISION",
            "TRANSACTION_PROPOSAL",
            "ENDORSEMENT",
            "POLICY_CHECK",
            "COMMUNICATION",
            "STOCHASTIC_EVENT",
            "CONSEQUENCE",
            "FEEDBACK",
            "REFLECTION",
            "COMPLETION"
          ]
        },
        "title": { "$ref": "#/$defs/localizedText" },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        },
        "body": { "$ref": "#/$defs/localizedText" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "decisionId": { "$ref": "#/$defs/identifier" },
        "prompt": { "$ref": "#/$defs/localizedText" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decisionField" }
        },
        "justification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "maximumLength"],
          "properties": {
            "required": { "type": "boolean" },
            "maximumLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "proposalType": { "$ref": "#/$defs/identifier" },
        "sourceDecisionId": { "$ref": "#/$defs/identifier" },
        "policyIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "legacyActionBindingId": { "$ref": "#/$defs/identifier" },
        "proposalNodeId": { "$ref": "#/$defs/identifier" },
        "policyId": { "$ref": "#/$defs/identifier" },
        "permittedRoleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "messageId": { "$ref": "#/$defs/identifier" },
        "message": { "$ref": "#/$defs/localizedText" },
        "visibleToRoleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "randomStreamId": { "$ref": "#/$defs/identifier" },
        "outcomes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/stochasticOutcome" }
        },
        "consequenceCode": { "$ref": "#/$defs/identifier" },
        "feedbackCode": { "$ref": "#/$defs/identifier" },
        "reflectionId": { "$ref": "#/$defs/identifier" },
        "maximumLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "outcomeCode": { "$ref": "#/$defs/identifier" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "nodeType": { "const": "BRIEFING" } },
            "required": ["nodeType"]
          },
          "then": { "required": ["body"] }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "EVIDENCE_RELEASE" } },
            "required": ["nodeType"]
          },
          "then": { "required": ["evidenceIds"] }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "DECISION" } },
            "required": ["nodeType"]
          },
          "then": { "required": ["decisionId", "prompt", "fields"] }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "TRANSACTION_PROPOSAL" } },
            "required": ["nodeType"]
          },
          "then": {
            "required": ["proposalType", "sourceDecisionId", "policyIds"]
          }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "ENDORSEMENT" } },
            "required": ["nodeType"]
          },
          "then": {
            "required": ["proposalNodeId", "policyId", "permittedRoleIds"]
          }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "POLICY_CHECK" } },
            "required": ["nodeType"]
          },
          "then": { "required": ["proposalNodeId", "policyId"] }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "COMMUNICATION" } },
            "required": ["nodeType"]
          },
          "then": {
            "required": ["messageId", "message", "visibleToRoleIds"]
          }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "STOCHASTIC_EVENT" } },
            "required": ["nodeType"]
          },
          "then": { "required": ["randomStreamId", "outcomes"] }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "CONSEQUENCE" } },
            "required": ["nodeType"]
          },
          "then": { "required": ["consequenceCode", "message"] }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "FEEDBACK" } },
            "required": ["nodeType"]
          },
          "then": { "required": ["feedbackCode", "message"] }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "REFLECTION" } },
            "required": ["nodeType"]
          },
          "then": {
            "required": ["reflectionId", "prompt", "maximumLength"]
          }
        },
        {
          "if": {
            "properties": { "nodeType": { "const": "COMPLETION" } },
            "required": ["nodeType"]
          },
          "then": {
            "required": ["outcomeCode"],
            "properties": {
              "transitions": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "legacyActionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "nodeId", "commandType", "legacyActionId"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/identifier" },
        "nodeId": { "$ref": "#/$defs/identifier" },
        "commandType": { "$ref": "#/$defs/identifier" },
        "legacyActionId": { "$ref": "#/$defs/identifier" }
      }
    },
    "legacyCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterId",
        "scenarioId",
        "scenarioVersion",
        "stageId",
        "actionBindings"
      ],
      "properties": {
        "adapterId": { "const": "tracechain-coffee-v2" },
        "scenarioId": { "$ref": "#/$defs/identifier" },
        "scenarioVersion": { "$ref": "#/$defs/version" },
        "stageId": { "$ref": "#/$defs/identifier" },
        "actionBindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/legacyActionBinding" }
        }
      }
    },
    "runModeConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowHints",
        "allowRetry",
        "allowBacktracking",
        "feedbackTiming",
        "showScores",
        "outcomeStrategy",
        "seedPolicy",
        "allowCommunication",
        "allowEvidenceRequests"
      ],
      "properties": {
        "mode": {
          "enum": ["tutorial", "standard", "sandbox", "configured"]
        },
        "allowHints": { "type": "boolean" },
        "allowRetry": { "type": "boolean" },
        "allowBacktracking": { "type": "boolean" },
        "feedbackTiming": {
          "enum": ["immediate", "stage-end", "final"]
        },
        "showScores": { "type": "boolean" },
        "outcomeStrategy": {
          "enum": ["forced", "probabilistic"]
        },
        "seedPolicy": {
          "enum": ["supplied", "generated"]
        },
        "timeLimitMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "allowCommunication": { "type": "boolean" },
        "allowEvidenceRequests": { "type": "boolean" },
        "outcomeModelId": { "$ref": "#/$defs/identifier" },
        "forcedOutcomeCode": { "$ref": "#/$defs/identifier" }
      }
    },
    "outcomeModel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcomeModelId",
            "distribution",
            "randomStreamId",
            "probability",
            "onTrue",
            "onFalse"
          ],
          "properties": {
            "outcomeModelId": { "$ref": "#/$defs/identifier" },
            "distribution": { "const": "bernoulli" },
            "randomStreamId": { "$ref": "#/$defs/identifier" },
            "probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "onTrue": { "$ref": "#/$defs/identifier" },
            "onFalse": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcomeModelId",
            "distribution",
            "randomStreamId",
            "outcomes"
          ],
          "properties": {
            "outcomeModelId": { "$ref": "#/$defs/identifier" },
            "distribution": { "const": "weighted-categorical" },
            "randomStreamId": { "$ref": "#/$defs/identifier" },
            "outcomes": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["outcomeCode", "weight"],
                "properties": {
                  "outcomeCode": { "$ref": "#/$defs/identifier" },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "version",
        "status",
        "title",
        "supportedModes",
        "competencyTargets",
        "organizations",
        "roles",
        "assetTypes",
        "initialState",
        "policies",
        "evidenceItems",
        "entryNodeId",
        "nodes",
        "rubricIds",
        "evidenceRuleIds"
      ],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "status": { "$ref": "#/$defs/lifecycleStatus" },
        "title": { "$ref": "#/$defs/localizedText" },
        "supportedModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["tutorial", "standard", "sandbox", "configured"]
          }
        },
        "modeConfigurations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/runModeConfiguration"
          }
        },
        "outcomeModels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcomeModel"
          }
        },
        "competencyTargets": {
          "type": "array",
          "items": { "$ref": "#/$defs/competencyTarget" }
        },
        "organizations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/organization" }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/role" }
        },
        "assetTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetType" }
        },
        "initialState": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actualState",
            "businessState",
            "ledgerState",
            "informationState"
          ],
          "properties": {
            "actualState": { "type": "object" },
            "businessState": { "type": "object" },
            "ledgerState": { "type": "object" },
            "informationState": { "type": "object" }
          }
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/$defs/policy" }
        },
        "evidenceItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "entryNodeId": { "$ref": "#/$defs/identifier" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "rubricIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "evidenceRuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "legacyCompatibility": {
          "$ref": "#/$defs/legacyCompatibility"
        }
      }
    }
  }
}
